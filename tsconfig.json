{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2016",
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "types": ["node"]
  },
  "exclude": [
    "node_modules",
    ".vscode-test"
  ]
}
